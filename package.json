{
  "name": "agisse",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run ext:zip && npm run docs:build",
    "dev": "vite",
    "build": "npm run ext:zip && npm run docs:build && npm run cf-typegen && tsc -b && vite build",
    "ext:zip": "rm -f public/agisse-extension.zip && cd extension && zip -qr ../public/agisse-extension.zip .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "lint": "oxlint",
    "check": "for f in $(git ls-files '*.check.ts'); do tsx \"$f\" || exit 1; done",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "node --env-file=.env ./node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node --env-file=.env ./node_modules/.bin/drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:studio": "node --env-file=.env ./node_modules/.bin/drizzle-kit studio",
    "secrets": "sh ./scripts/put-secrets.sh",
    "self-host": "sh ./scripts/self-host.sh",
    "indexnow": "sh ./scripts/indexnow.sh",
    "quality": "tsx --env-file-if-exists=.env scripts/quality.ts",
    "eval": "tsx --env-file-if-exists=.env scripts/eval.ts",
    "eval:export": "tsx --env-file=.env scripts/eval-export.ts",
    "sponsors:import": "tsx --env-file=.env scripts/import-sponsors.ts",
    "eval:feed": "tsx --env-file=.env scripts/eval-feed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@assistant-ui/react": "^0.15.27",
    "@base-ui/react": "^1.9.0",
    "@better-auth/mcp": "^1.7.7",
    "@better-auth/oauth-provider": "^1.7.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@neondatabase/serverless": "^1.2.0",
    "@sentry/cloudflare": "^11.6.0",
    "@sentry/hono": "^11.6.0",
    "better-auth": "^1.7.6",
    "border-beam": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "lucide-react": "^1.55.0",
    "maplibre-gl": "^6.13.0",
    "motion": "^14.1.0",
    "pdfjs-dist": "^6.4.299",
    "posthog-js": "^1.438.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-2d": "^1.29.2",
    "shadcn": "^4.21.4",
    "thinking-orbs": "^0.3.2",
    "tw-animate-css": "^1.4.0",
    "wouter": "^3.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@cloudflare/vite-plugin": "^1.63.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@sentry/vite-plugin": "^5.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.87.0",
    "playwright-core": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitepress": "^1.6.4",
    "wrangler": "^4.135.0"
  }
}
