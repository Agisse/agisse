{
  "name": "agisse",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "agisse": "dist/agisse.mjs"
  },
  "files": [
    "dist/client",
    "!dist/client/**/*.map",
    "dist/agisse.mjs",
    "drizzle",
    "!drizzle/meta/*_snapshot.json",
    "wrangler.jsonc",
    "source"
  ],
  "scripts": {
    "predev": "npm run ext:zip && npm run docs:build",
    "dev": "vite",
    "build": "npm run ext:zip && npm run docs:build && npm run cf-typegen && tsc -b && vite build",
    "ext:zip": "rm -f public/agisse-extension.zip && cd extension && zip -qr ../public/agisse-extension.zip .",
    "local": "tsx local/server.ts",
    "build:local": "rolldown -c local/rolldown.config.mjs",
    "prepack": "sh scripts/source-archive.sh && npm run build && npm run build:local",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "lint": "oxlint",
    "check": "for f in $(git ls-files '*.check.ts'); do tsx \"$f\" || exit 1; done",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "node --env-file=.env ./node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node --env-file=.env ./node_modules/.bin/drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:studio": "node --env-file=.env ./node_modules/.bin/drizzle-kit studio",
    "secrets": "sh ./scripts/put-secrets.sh",
    "self-host": "sh ./scripts/self-host.sh",
    "indexnow": "sh ./scripts/indexnow.sh",
    "quality": "tsx --env-file-if-exists=.env scripts/quality.ts",
    "eval": "tsx --env-file-if-exists=.env scripts/eval.ts",
    "eval:export": "tsx --env-file=.env scripts/eval-export.ts",
    "sponsors:import": "tsx --env-file=.env scripts/import-sponsors.ts",
    "eval:feed": "tsx --env-file=.env scripts/eval-feed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@better-auth/mcp": "^1.7.10",
    "@better-auth/oauth-provider": "^1.7.6",
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-pgvector": "^0.0.11",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@neondatabase/serverless": "^1.2.0",
    "@sentry/cloudflare": "^11.8.0",
    "@sentry/hono": "^11.8.0",
    "@sentry/react": "~11.8.0",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@assistant-ui/react": "^0.15.29",
    "@babel/core": "^7.29.7",
    "@base-ui/react": "^1.9.0",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@sentry/vite-plugin": "^5.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "border-beam": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-kit": "^0.31.11",
    "lucide-react": "^1.59.0",
    "maplibre-gl": "^6.14.0",
    "oxlint": "^1.88.0",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "posthog-js": "^1.438.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-force-graph-2d": "^1.29.2",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.3.3",
    "thinking-orbs": "^0.3.2",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitepress": "^1.6.4",
    "wouter": "^3.13.0",
    "wrangler": "^4.135.0"
  },
  "description": "Open-source job-search copilot for students and early-career people in Europe",
  "keywords": [
    "job-search",
    "career",
    "copilot",
    "self-hosted",
    "mcp",
    "ai"
  ],
  "homepage": "https://agisse.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Agisse/agisse.git"
  },
  "overrides": {
    "vitepress": {
      "vite": "^6.4.3"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
