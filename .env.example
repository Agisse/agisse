DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Self-host only (npm run self-host): a domain on your Cloudflare account, or workers.dev.
SELF_HOST_DOMAIN=
# Optional: the server's AI key. Without it, each user connects their own under Profile → AI.
OPENROUTER_API_KEY=
# Optional: people search.
EXA_API_KEY=
# Optional: enables Search by city on the Job board.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
BETTER_AUTH_SECRET=  # openssl rand -base64 32
# The one admin account (approves invites, sees all users). Unset means no admin.
ADMIN_EMAIL=
SENTRY_DSN=
# Optional, build-time: browser error reports. Unset, the browser sends nothing to Sentry.
VITE_SENTRY_DSN=
# Build-time only (source map upload) — an org auth token with project:releases scope, never deployed as a Worker secret.
SENTRY_AUTH_TOKEN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
# Optional: deleting an account also deletes its PostHog person and events. A personal API key with person:write, and the
# project's API URL, e.g. https://eu.posthog.com/api/projects/12345
POSTHOG_PERSONAL_API_KEY=
POSTHOG_API_URL=
# logo.dev publishable key (pk_…); logos fall back to monograms without it. Never the sk_ secret.
VITE_LOGO_DEV_TOKEN=
RESEND_API_KEY=
# Sender for Resend mail, on a domain verified there. Defaults to hello@agisse.xyz.
EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
