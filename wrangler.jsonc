{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agisse",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // Hashed build files skip the Worker (headers and caching in public/_headers) and 404 when missing, so a
    // stale chunk name never caches index.html for a year. Everything else runs the Worker: the API, /mcp,
    // and the HTML it rewrites, with its own SPA fallback. The zone redirects http → https and www → apex.
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/assets/*", "!/docs/assets/*"]
  },
  "observability": { "enabled": true },
  // Run the Worker near the database (Neon, EU) when that's faster: most API routes make several round trips.
  "placement": { "mode": "smart" },
  // Daily: mark saved postings their public ATS board no longer lists as closed (worker/lib/closed.ts).
  "triggers": { "crons": ["17 4 * * *"] },
  "secrets": { "required": ["DATABASE_URL", "BETTER_AUTH_SECRET"] },
  // Sentry release tagging: ties each event to the deployed Worker version, no separate release step needed.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Original résumé PDFs, one per user: resumes/<userId>.pdf
  // Free on every plan. namespace_id is any account-unique integer string.
  // AUTH: sign-in/up/reset POSTs per IP. API: non-GET /api calls per signed-in user (bursts that would hit paid models).
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1701", "simple": { "limit": 10, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1702", "simple": { "limit": 60, "period": 60 } }
  ],
  "r2_buckets": [{ "binding": "RESUMES", "bucket_name": "agisse-resumes-eu", "jurisdiction": "eu" }],
  "routes": [
    { "pattern": "agisse.xyz", "custom_domain": true },
    { "pattern": "www.agisse.xyz", "custom_domain": true }
  ],
  "vars": {
    // Comma-separated preference list for Agisse's key: free models only (owner, 2026-10-14), then auto-discovered ":free" ones.
    // If Agisse's key ever pays for a model again, put Haiku first ("anthropic/claude-haiku-5.5"), never "openrouter/auto".
    "OPENROUTER_MODELS": "nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,dots-studio/dots-3-note-preview:free,apodex/apodex-1.1-mini:free",
    // Accounts with a one-time credit (invite, an admin's ref link, or the sign-up credit) get these on Agisse's key first, until the credit is spent.
    "OPENROUTER_CREDIT_MODELS": "anthropic/claude-haiku-5.5",
    // One-time credit in € for every new account (owner, 2026-10-16). An invite's or an admin's ref link's credit replaces it.
    // Self-hosters: "0" turns it off; it only ever spends on OPENROUTER_CREDIT_MODELS.
    "SIGNUP_CREDIT_EUR": "1",
    // Paid models below run only on a seeker's own OpenRouter key.
    // "Smart" model setting: tried first, then paid models under SMART_MAX_USD_PER_M ($ per 1M output tokens), then the free chain.
    "OPENROUTER_CHECK_MODELS": "google/gemini-3.8-flash",
    // deepseek-v4-pro (60-170 s) and qwen3.8-flash (burns max_tokens reasoning) dropped: they time out on every structured task; gemini does them in 1-8 s.
    "OPENROUTER_SMART_MODELS": "google/gemini-3.8-flash",
    "SMART_MAX_USD_PER_M": "2",
    // Mock-interview transcription when the browser has no speech recognition (Firefox): takes audio input, cents per hour.
    "OPENROUTER_AUDIO_MODEL": "google/gemini-3.8-flash",
    // Default monthly allowance per user in €; the admin can override it per account.
    "MONTHLY_BUDGET_EUR": "5",
    // Share of what a user spends that is kept as margin: 1/3 = cost × 1.5, a 50% markup (a €10 allowance costs us at most ~€6.67).
    "PRICE_MARGIN": "0.333333",
    // Nominal € per million OpenRouter tokens (free models bill $0). Generous: €2 ≈ 40M tokens.
    "TOKEN_EUR_PER_MILLION": "0.05",
    // Provider costs arrive in USD; update when the rate drifts.
    "USD_TO_EUR": "0.86",
    // Kill switch: total provider spend per UTC day across every user. Past it all AI features pause until midnight.
    "GLOBAL_DAILY_USD_CAP": "15",
    // Actions per UTC day on this server's key, per account and for everyone ("0" = no limit). Seekers with their own key skip both.
    // OpenRouter's free models allow 1,000 requests a day per OpenRouter account (50 before $10 of credits); one action can take a few attempts.
    "FREE_DAILY_ACTIONS": "15",
    "FREE_DAILY_ACTIONS_ALL": "600",
    // Feed pages (30 roles each) per account per UTC day, so the hosted feed can't be copied in bulk ("0" = no cap). Admins skip it.
    "FEED_DAILY_PAGES": "200",
    // Local dev overrides this to "development" via .dev.vars if you add one; deployed always sends "production".
    "SENTRY_ENVIRONMENT": "production",
    // Links in mail the daily cron sends. With RESEND_API_KEY it also turns on deleting accounts unused for 24 months
    // (warned by email 30 days before); without either, nobody is warned and nobody is deleted.
    "APP_URL": "https://agisse.xyz",
    // "1" turns on the launch-day homepage. The owner flips it; until then the launch sections ship dark.
    "PUBLIC_LAUNCH": "0"
  }
  // Secrets (set with `wrangler secret put <NAME>` or `npm run secrets`):
  // DATABASE_URL, BETTER_AUTH_SECRET
  // Optional (feature stays off without them): OPENROUTER_API_KEY (else every user brings their own key), EXA_API_KEY, SENTRY_DSN, RESEND_API_KEY, EMAIL_FROM, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, TURNSTILE_SECRET_KEY, GROUP_INVITE
}
