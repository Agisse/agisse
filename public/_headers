# Hashed build files, served without the Worker (wrangler.jsonc run_worker_first).
# The same security headers the Worker sets everywhere else (worker/index.ts).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(self), geolocation=(), microphone=(self)

/docs/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(self), geolocation=(), microphone=(self)
