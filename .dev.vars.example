# The minimum for `npm run dev`. Copy to both .dev.vars (read by the Worker) and .env (read by the db:* scripts).
# The other keys in .env.example are optional.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
BETTER_AUTH_SECRET=  # openssl rand -base64 32
# Optional: without it, connect your own AI key under Profile → AI after signing in.
OPENROUTER_API_KEY=
